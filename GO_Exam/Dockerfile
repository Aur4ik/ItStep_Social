# ─── Этап 1: сборка ───────────────────────────────────────────────────────────
FROM golang:1.25-alpine AS builder

# Нужные инструменты для сборки
RUN apk add --no-cache git

WORKDIR /app

# Сначала копируем зависимости — чтобы Docker кэшировал этот слой
# и не качал их заново при каждом изменении кода
COPY go.mod go.sum ./
RUN go mod download

# Копируем весь остальной код
COPY . .

# Собираем бинарник
# CGO_ENABLED=0 — статическая сборка (не нужны системные библиотеки)
# -o app — имя выходного файла
RUN CGO_ENABLED=0 GOOS=linux go build -o app ./cmd/main.go


# ─── Этап 2: финальный образ ──────────────────────────────────────────────────
# alpine — очень маленький образ (~5 МБ), без лишнего
FROM alpine:latest

WORKDIR /app

# Копируем только готовый бинарник из этапа сборки
COPY --from=builder /app/app .

# Папка для загружаемых файлов (аватарки и т.д.)
RUN mkdir -p uploads

EXPOSE 8080

CMD ["./app"]
